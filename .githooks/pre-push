#!/bin/sh
# User journey checks (docs/user-journeys/README.md).
# Installed by `composer install` via core.hooksPath. Bypass: --no-verify or JOURNEYS_SKIP=1.

# git passes the refs being pushed on stdin; buffer them so both the legacy
# hook (if any) and the journey checks can read them.
refs="$(cat)"

# Keep any hook that existed in .git/hooks before core.hooksPath was set.
legacy="$(git rev-parse --git-common-dir)/hooks/pre-push"
if [ -x "$legacy" ]; then
    printf '%s\n' "$refs" | "$legacy" "$@" || exit $?
fi

[ "$JOURNEYS_SKIP" = "1" ] && exit 0

if ! command -v php >/dev/null 2>&1; then
    echo "journeys: php not found; skipping pre-push checks" >&2
    exit 0
fi

printf '%s\n' "$refs" | php bin/journeys hook pre-push "$@"
